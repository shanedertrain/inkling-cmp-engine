# Copy to scripts/local.sh (not in git) and adjust for your machine.
# scripts/config.sh loads scripts/local.sh first; environment variables override both.

# Space-separated CUDA GPU indices to serve (one replica per card).
# Example: GPUS="0" for a single card, or GPUS="0 1 2 3 4 5 6 7" for 8 cards.
GPUS="0"

# Loopback ports: GPU N listens on 127.0.0.1:$((BASE_PORT + N)) (default 8400..8407).
BASE_PORT=8400

# Path to thinkingmachines/Inkling-2-Mini (auto-downloaded into HF_CACHE if unset).
# MODEL_DIR="/path/to/Inkling-2-Mini"
HF_CACHE="${HOME}/.cache/huggingface"

# Optional: Hugging Face token (only needed if gated or rate-limited).
# HF_TOKEN=""

# Serving configuration (matches README v1.3.0 defaults).
SLOTS=8
MAX_RUNNING=8
# PAGES defaults to 960 (BF16 lossless, 983K tok/card; max 1,015 / 1.04M) or 1728 when KV_FP8=1 (1.77M tok/card; max 1,789 / 1.83M).
# PAGES=960
CHUNK=8192
LOOKUP=8
KV_FP8=0
DCTX=262144
CPUS=6

# Opt-in: path to Inkling-2-Mini-DFlash2-Global-L13 (https://huggingface.co/cambash23/Inkling-2-Mini-DFlash2-Global-L13)
# or incoai/Inkling-2-Mini-DFlash2 checkpoint directory (replaces DSpark).
# DFLASH2_DIR=""

# Extra flags passed verbatim to ink-server (e.g. "--lookup 0").
# EXTRA_ARGS=""

# Docker base CUDA image for building inkling-cmp-engine (CUDA 13.x required).
# CUDA_IMAGE="nvidia/cuda:13.0.0-devel-ubuntu24.04"
