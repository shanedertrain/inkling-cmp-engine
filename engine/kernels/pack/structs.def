           INK_F(t_lrow) INK_F(t_par) INK_F(t_pos) INK_F(out) INK_F(stats) INK_F(keys))
INK_STRUCT(ink::LeviathanArgs, INK_F(lg) INK_F(ld) INK_F(vocab) INK_F(par) INK_F(lrow) INK_F(call_pos) INK_F(call_seg)
           INK_F(call_row0) INK_F(call_slot) INK_F(nseg) INK_F(T) INK_F(drafts) INK_F(prop_ids) INK_F(prop_w) INK_F(out))
