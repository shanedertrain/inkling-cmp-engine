// Kernel pack: every C++ struct a kernel takes by value or through a pointer, with its fields (package R2,
// docs/RUST-PLAN.md 3.2). Read by layout_emit.cpp (X-macro): INK_STRUCT(type, INK_F(field) ...). Field types, sizes,
// alignments and offsets come from the compiler; layout_emit fails when the listed fields plus alignment padding do
// not cover sizeof(type) (a field missing here), and xtask gen-kernels fails when a kernel parameter or a field has
// a struct type not listed here. A struct used inside another one is listed before it.

// decode_attn (engine/kernels/decode_attn/decode_attn.cuh)
INK_STRUCT(da::Params, INK_F(k) INK_F(v) INK_F(page_table) INK_F(pt_stride) INK_F(page_shift) INK_F(page_stride)
           INK_F(head_stride) INK_F(row_stride) INK_F(window) INK_F(ctx) INK_F(row0) INK_F(chunk_shift) INK_F(R)
           INK_F(nrows) INK_F(q) INK_F(rel) INK_F(extent) INK_F(gate) INK_F(sink) INK_F(o_part) INK_F(ml_part)
           INK_F(max_chunks) INK_F(out) INK_F(out32) INK_F(sc) INK_F(vscale))
// prefill_attn (engine/kernels/prefill_attn/prefill_attn.cuh)
INK_STRUCT(pfa::Seg, INK_F(q0) INK_F(len) INK_F(past) INK_F(pt_off))
INK_STRUCT(pfa::Params, INK_F(q) INK_F(k) INK_F(v) INK_F(s_page) INK_F(s_slot) INK_F(s_head) INK_F(page_shift)
           INK_F(page_table) INK_F(rel) INK_F(rel_proj_t) INK_F(gate) INK_F(sink) INK_F(out) INK_F(o32) INK_F(lse) INK_F(segs)
           INK_F(items) INK_F(items2) INK_F(ws) INK_F(cnt) INK_F(window) INK_F(qk_scale))
// prefill_moe (engine/kernels/prefill_moe/prefill_moe.cuh)
INK_STRUCT(pmoe::Item, INK_F(e) INK_F(ft) INK_F(p0) INK_F(cnt))
INK_STRUCT(pmoe::Params, INK_F(A) INK_F(a_row) INK_F(W) INK_F(S) INK_F(F) INK_F(items) INK_F(n_items)
           INK_F(n_items_dev) INK_F(K) INK_F(NWT) INK_F(out) INK_F(out_row) INK_F(gamma))
