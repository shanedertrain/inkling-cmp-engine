           INK_F(rn) INK_F(B) INK_F(Bq) INK_F(enorm) INK_F(hrn) INK_F(hnorm) INK_F(hdn) INK_F(qhn) INK_F(hsc)
           INK_F(hn_in) INK_F(head) INK_F(h) INK_F(state) INK_F(latent) INK_F(lat2) INK_F(keys) INK_F(seedkeys)
